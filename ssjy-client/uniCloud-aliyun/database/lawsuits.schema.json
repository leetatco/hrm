			"description": "诉讼主体: company/actual_controller_spouse"
		},
		"is_restricted": {
			"bsonType": "bool",
			"description": "是否限高"
		},
		"role": {
			"bsonType": "string",
			"description": "被告/原告"
		},
		"case_amount": {
			"bsonType": "double",
			"description": "标的额(万元)"
		},
		"case_progress": {
			"bsonType": "string",
			"description": "诉讼进展"
		},
		"frozen_amount": {
			"bsonType": "double",
			"description": "保全/冻结额(万元)"
