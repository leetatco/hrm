{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"customer_id": {
			"bsonType": "string",
			"foreignKey": "customers._id",
			"description": "关联客户ID"
		},
		"year": {
			"bsonType": "int",
			"description": "年份"
		},
		"tax_type": {
			"bsonType": "string",
			"description": "税种(增值税/企业所得税/代缴个税/合计)"
		},
		"tax_rate": {
			"bsonType": "string",
			"description": "税率"
		},
		"tax_paid": {
			"bsonType": "double",
			"description": "已交税款(万元)"
		},
		"is_overdue": {
			"bsonType": "bool",
			"description": "是否逾期"
		},
		"is_tax_refund": {
			"bsonType": "bool",
			"description": "是否退税"
		},
		"estimated_next_year": {
			"bsonType": "double",
			"description": "下年度预计税款(万元)"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	}
}