/* vk-uview-ui/index.wxss */
/* 按钮样式 */
.u-button {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  transition: all 0.3s;
  border: none;
  cursor: pointer;
}

.u-button--primary {
  background-color: #007aff;
  color: #fff;
}

.u-button--success {
  background-color: #4cd964;
  color: #fff;
}

.u-button--warning {
  background-color: #ff9500;
  color: #fff;
}

/* 头像样式 */
.u-avatar {
  display: inline-block;
  border-radius: 50%;
  overflow: hidden;
}

.u-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}