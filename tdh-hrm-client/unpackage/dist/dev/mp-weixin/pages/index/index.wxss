/* ============================================================
   全局容器
   ============================================================ */
.container.data-v-1cf27b2a {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ============================================================
   固定区域（头部 + 搜索 + 轮播）
   ============================================================ */
.sticky-area.data-v-1cf27b2a {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f7fa;
  padding: 0 0 20rpx 0;
}

/* ============================================================
   顶部区域（头部 + 搜索）- 升级版
   ============================================================ */
.top-section.data-v-1cf27b2a {
  position: relative;
  /* 更柔和的渐变背景，营造高级感 */
  background: linear-gradient(145deg, #f5f9ff 0%, #e6edf7 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 30rpx 30rpx 10rpx;
  overflow: hidden;
  /* 细腻的内阴影，增加层次感 */
  box-shadow: 0 8rpx 32rpx rgba(0, 20, 40, 0.04);
  /* 装饰性背景圆 - 高档设计元素 */
}
.top-section .bg-decoration.data-v-1cf27b2a {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, transparent 70%);
}
.top-section .bg-decoration-1.data-v-1cf27b2a {
  width: 400rpx;
  height: 400rpx;
  top: -200rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(64, 128, 255, 0.08) 0%, transparent 70%);
}
.top-section .bg-decoration-2.data-v-1cf27b2a {
  width: 200rpx;
  height: 200rpx;
  bottom: 20rpx;
  left: -60rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.06) 0%, transparent 70%);
}

