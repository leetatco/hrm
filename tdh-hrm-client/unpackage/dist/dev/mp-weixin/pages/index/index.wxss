/* ============================================================
   设计变量
   ============================================================ */
.data-v-1cf27b2a:root {
  --color-primary: #2979ff;
  --color-primary-light: #5a9cff;
  --color-bg: #f5f7fa;
  --color-card: #ffffff;
  --color-text-primary: #1a1a2e;
  --color-text-secondary: #666;
  --color-text-light: #999;
  --color-border: #f0f0f0;
  --shadow-card: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  --shadow-hover: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  --radius-card: 20rpx;
  --radius-inner: 16rpx;
  --card-gap: 24rpx;
  /* 👈 统一间距变量，方便全局调整 */
}
.search-btn.data-v-1cf27b2a {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #2979ff, #5a9cff);
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(41, 121, 255, 0.3);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.container.data-v-1cf27b2a {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ============================================================
   固定卡片区域 ———— 上下外边距 24rpx（8网格标准）
   ============================================================ */
.sticky-card.data-v-1cf27b2a {
  margin: var(--card-gap) 24rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  background: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.6) 0%, transparent 30%), radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.4) 0%, transparent 25%), radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.2) 0%, transparent 40%), linear-gradient(160deg, #ffffff 0%, #eaf6ff 30%, #fff0f6 60%, #f0fdf4 100%);
  position: relative;
}

/* 装饰光晕 1（左上角，天空蓝） */
.sticky-card.data-v-1cf27b2a::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(100, 180, 255, 0.35) 0%, rgba(100, 180, 255, 0.12) 45%, transparent 70%);
  pointer-events: none;
  animation: floatGlow-1cf27b2a 6s ease-in-out infinite;
}

/* 装饰光晕 2（右下角，亮橙色/金色） */
.sticky-card.data-v-1cf27b2a::after {
  content: "";
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 190, 50, 0.4) 0%, rgba(255, 170, 30, 0.18) 45%, transparent 70%);
  pointer-events: none;
  animation: floatGlow-1cf27b2a 8s ease-in-out infinite reverse;
}

/* 装饰光晕 3（中间偏上，樱花粉） */
.top-section.data-v-1cf27b2a::after {
  content: "";
  position: absolute;
  top: 20rpx;
  left: 40%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 180, 200, 0.35) 0%, rgba(255, 150, 180, 0.15) 50%, transparent 70%);
  pointer-events: none;
  animation: floatGlow-1cf27b2a 7s ease-in-out infinite;
}
@keyframes floatGlow-1cf27b2a {
0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.9;
}
50% {
    transform: translate(8rpx, -12rpx) scale(1.03);
    opacity: 1;
}
}
