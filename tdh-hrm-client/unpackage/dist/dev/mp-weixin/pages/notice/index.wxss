/* 文字尺寸 */
/*文字颜色*/
/* 边框颜色 */
/* 图片加载中颜色 */
.container.data-v-a41149ed {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f9ff 0%, #f0f4fa 100%);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ========== 筛选区域 ========== */
.filter-section.data-v-a41149ed {
  background: linear-gradient(160deg, #ffffff 0%, #f8fbff 100%);
  padding: 24rpx 30rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 6rpx 30rpx rgba(180, 210, 240, 0.15);
  margin-bottom: 4rpx;
}
.filter-section .search-box.data-v-a41149ed {
  margin-bottom: 24rpx;
}
.filter-section .search-box.data-v-a41149ed .u-search {
  background: rgba(255, 255, 255, 0.8) !important;
  border-radius: 40rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(180, 210, 240, 0.2);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}
.filter-section .search-box.data-v-a41149ed .u-search .u-search__content {
  background: transparent !important;
}
.filter-section .search-box.data-v-a41149ed .u-search .u-search__content__input {
  font-size: 28rpx;
  color: #333;
}
.filter-section .search-box.data-v-a41149ed .u-search .u-search__content__icon {
  color: #999;
}
.filter-section .filter-row.data-v-a41149ed {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  width: 100%;
}
.filter-section .filter-row .filter-tags-container.data-v-a41149ed {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}
.filter-section .filter-row .filter-tags.data-v-a41149ed {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  overflow-x: auto;
  padding-bottom: 4rpx;
}
.filter-section .filter-row .filter-tags.data-v-a41149ed::-webkit-scrollbar {
  display: none;
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed {
  flex-shrink: 0;
  margin-right: 20rpx;
  /* 选中态更柔和 */
  /* 未选中态 */
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed:last-child {
  margin-right: 0;
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed .u-tag {
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  white-space: nowrap;
  font-size: 26rpx;
  transition: all 0.2s;
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed .u-tag--primary {
  background: #e8f1ff !important;
  color: #2979ff !important;
  border-color: #c9ddff !important;
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed .u-tag--info {
  background: #f2f5f9 !important;
  color: #7a8a9f !important;
  border-color: #e4e9f0 !important;
}
.filter-section .filter-row .action-buttons.data-v-a41149ed {
  flex-shrink: 0;
  margin-left: 20rpx;
  min-width: 140rpx;
}
.filter-section .filter-row .action-buttons .mark-all-btn.data-v-a41149ed .u-button {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 22rpx;
  white-space: nowrap;
  border-radius: 28rpx;
  background: #2979ff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(41, 121, 255, 0.3);
  transition: all 0.2s;
}
.filter-section .filter-row .action-buttons .mark-all-btn.data-v-a41149ed .u-button[disabled] {
  background: #c8d6e8 !important;
  color: #fff !important;
  border-color: #c8d6e8 !important;
  opacity: 0.6;
  box-shadow: none;
}
.filter-section .filter-row .action-buttons .mark-all-btn .btn-text.data-v-a41149ed {
  margin-left: 8rpx;
}

/* ========== 通知列表 ========== */
.notice-list.data-v-a41149ed {
  height: calc(100vh - 240rpx);
}
.empty-state.data-v-a41149ed {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.empty-state.loading.data-v-a41149ed {
  height: 600rpx;
}
.empty-state .empty-tips.data-v-a41149ed {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #a0b0c0;
  text-align: center;
}
.notice-items.data-v-a41149ed {
  padding: 28rpx 30rpx;
}
.notice-item.data-v-a41149ed {
  display: flex;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 210, 240, 0.12);
  transition: all 0.2s;
}
.notice-item.data-v-a41149ed:active {
  background-color: #fafcff;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(180, 210, 240, 0.15);
}
.notice-item.unread.data-v-a41149ed {
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
  border-left: 6rpx solid #2979ff;
  /* 改用渐变左边框效果 */
  position: relative;
}
.notice-item.unread.data-v-a41149ed::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #5a9cff, #2979ff);
  border-radius: 6rpx 0 0 6rpx;
}
.notice-item.unread.data-v-a41149ed:active {
  background: linear-gradient(135deg, #f5faff 0%, #e8f2ff 100%);
}
.notice-item .notice-status.data-v-a41149ed {
  margin-right: 20rpx;
  display: flex;
  align-items: flex-start;
  padding-top: 6rpx;
}
.notice-item .notice-status .unread-dot.data-v-a41149ed {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #2979ff;
  box-shadow: 0 0 0 4rpx rgba(41, 121, 255, 0.15);
}
.notice-item .notice-content.data-v-a41149ed {
  flex: 1;
}
.notice-item .notice-content .notice-header.data-v-a41149ed {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.notice-item .notice-content .notice-header .notice-title.data-v-a41149ed {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2a3441;
  line-height: 1.4;
  margin-right: 20rpx;
}
.notice-item .notice-content .notice-header .notice-badges.data-v-a41149ed {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}
.notice-item .notice-content .notice-header .notice-badges .priority-badge.data-v-a41149ed {
  background: #f56c6c;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 108, 108, 0.3);
}
.notice-item .notice-content .notice-body.data-v-a41149ed {
  margin-bottom: 16rpx;
}
.notice-item .notice-content .notice-body .notice-text.data-v-a41149ed {
  font-size: 28rpx;
  color: #5a6b7d;
  line-height: 1.5;
}
.notice-item .notice-content .notice-footer.data-v-a41149ed {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.notice-item .notice-content .notice-footer .notice-time.data-v-a41149ed {
  display: flex;
  align-items: center;
}
.notice-item .notice-content .notice-footer .notice-time .time-text.data-v-a41149ed {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #a0b0c0;
}
.notice-item .notice-content .notice-footer .notice-sender .sender-text.data-v-a41149ed {
  font-size: 24rpx;
  color: #a0b0c0;
}
.notice-item .notice-content .notice-actions.data-v-a41149ed {
  display: flex;
  gap: 20rpx;
}
.notice-item .notice-content .notice-actions .action-btn.data-v-a41149ed .u-button {
  padding: 0 24rpx;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 25rpx;
  background: #e8f1ff;
  color: #2979ff;
  border: 1rpx solid #c9ddff;
  font-size: 24rpx;
}
.notice-item .notice-content .notice-actions .action-btn.data-v-a41149ed .u-button:active {
  background: #d4e5ff;
}
.load-more.data-v-a41149ed,
.no-more.data-v-a41149ed {
  padding: 28rpx 0;
  text-align: center;
}
.load-more .no-more-text.data-v-a41149ed,
.no-more .no-more-text.data-v-a41149ed {
  font-size: 26rpx;
  color: #a0b0c0;
}
.bottom-tabbar.data-v-a41149ed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

/* ========== 响应式调整 ========== */
@media (max-width: 750px) {
.filter-section.data-v-a41149ed {
    padding: 20rpx 24rpx;
}
.filter-section .filter-row .filter-tags.data-v-a41149ed {
    overflow-x: auto;
}
.filter-section .filter-row .filter-tags .filter-tag.data-v-a41149ed {
    margin-right: 15rpx;
}
.filter-section .filter-row .action-buttons.data-v-a41149ed {
    margin-left: 15rpx;
    min-width: 130rpx;
}
.filter-section .filter-row .action-buttons .mark-all-btn.data-v-a41149ed .u-button {
    padding: 0 15rpx;
    font-size: 22rpx;
}
.notice-items.data-v-a41149ed {
    padding: 20rpx 24rpx;
}
.notice-item.data-v-a41149ed {
    padding: 22rpx 20rpx;
}
.notice-item .notice-content .notice-header.data-v-a41149ed {
    flex-direction: column;
    align-items: flex-start;
}
.notice-item .notice-content .notice-header .notice-title.data-v-a41149ed {
    margin-right: 0;
    margin-bottom: 10rpx;
}
.notice-item .notice-content .notice-footer.data-v-a41149ed {
    flex-direction: column;
    align-items: flex-start;
    gap: 10rpx;
}
}