/* 边框颜色 */
/* 图片加载中颜色 */
.settings-page.data-v-2d28db0a {
  min-height: 100vh;
  background: #f8f9fc;
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
}

/* 提示卡片 */
.hint-card.data-v-2d28db0a {
  margin-bottom: 24rpx;
  background: #fff9e6;
  border-radius: 20rpx;
  border-left: 8rpx solid #ff9f43;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04), 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
}
.hint-card__inner.data-v-2d28db0a {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.hint-card__text.data-v-2d28db0a {
  flex: 1;
  font-size: 26rpx;
  color: #b95f00;
  line-height: 1.4;
}

/* 主要信息卡片 */
.info-card.data-v-2d28db0a {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04), 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
}
.info-card__title.data-v-2d28db0a {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2f3a;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eef2f6;
}
.info-card__required.data-v-2d28db0a {
  font-size: 24rpx;
  color: #f44336;
  margin-left: auto;
}
.info-row.data-v-2d28db0a {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.info-row.data-v-2d28db0a:last-child {
  margin-bottom: 0;
}
.info-row__label.data-v-2d28db0a {
  width: 200rpx;
  font-size: 28rpx;
  color: #6c7a8a;
  flex-shrink: 0;
}
.info-row__input.data-v-2d28db0a {
  flex: 1;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2f3a;
  border: 1rpx solid #eef2f6;
  transition: all 0.2s;
}
.info-row__input.data-v-2d28db0a:focus {
  border-color: #2d8cff;
  background: #ffffff;
}
.info-row__unit.data-v-2d28db0a {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #99a9bf;
}
.placeholder-text.data-v-2d28db0a {
  color: #99a9bf;
  font-size: 28rpx;
}

/* 提示卡片 */
.tips-card.data-v-2d28db0a {
  background: #e8f4ff;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}
.tips-card__inner.data-v-2d28db0a {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.tips-card__text.data-v-2d28db0a {
  flex: 1;
  font-size: 26rpx;
  color: #0066cc;
  line-height: 1.4;
}

/* 底部按钮区域 */
.action-bar.data-v-2d28db0a {
  margin-top: auto;
  margin-bottom: 20rpx;
}
.action-bar__inner.data-v-2d28db0a {
  display: flex;
  gap: 24rpx;
}
.action-btn.data-v-2d28db0a {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border-radius: 60rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.1);
}
.action-btn.data-v-2d28db0a:active {
  transform: scale(0.96);
}
.action-btn--read.data-v-2d28db0a {
  background: linear-gradient(145deg, #5b8cff, #2d6ef0);
  color: #ffffff;
}
.action-btn--submit.data-v-2d28db0a {
  background: linear-gradient(145deg, #2d8cff, #1a6ad0);
  color: #ffffff;
}
.action-btn--disabled.data-v-2d28db0a {
  opacity: 0.6;
  transform: none;
  pointer-events: none;
}
.bottom-placeholder.data-v-2d28db0a {
  height: calc(30rpx + env(safe-area-inset-bottom));
}