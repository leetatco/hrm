}
.account-section .account-list .account-item .feedback-btn.data-v-79e6a490 {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
  position: relative;
}
.account-section .account-list .account-item .feedback-btn.data-v-79e6a490::after {
  display: none;
}

