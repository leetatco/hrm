/* ============================================================
   全局样式 – 与设置页面完全一致
   ============================================================ */
.page.data-v-79e6a490 {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  padding-bottom: 120rpx;
  padding: 1rpx 0;
  box-sizing: border-box;
}

/* ============================================================
   用户卡片（保留渐变，但间距与设置统一）
   ============================================================ */
.user-card.data-v-79e6a490 {
  background: linear-gradient(145deg, #4a7aff 0%, #6c8cff 60%, #8aa4ff 100%);
  border-radius: 24rpx;
  margin: 24rpx 24rpx;
  /* 上下左右统一 24rpx */
  padding: 40rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(41, 121, 255, 0.25);
  /* 装饰光晕 */
}
.user-card.not-login.data-v-79e6a490 {
  background: linear-gradient(145deg, #ff6b6b 0%, #ff8e8e 60%, #ffb0b0 100%);
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 107, 0.25);
}
.user-card.data-v-79e6a490::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  pointer-events: none;
}
.user-card.data-v-79e6a490::after {
  content: "";
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}
.user-card .card-content.data-v-79e6a490 {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.user-card .avatar-section.data-v-79e6a490 {
  flex-shrink: 0;
  margin-right: 24rpx;
}
.user-card .avatar-section.data-v-79e6a490 .u-avatar {
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.user-card .user-detail.data-v-79e6a490 {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.user-card .user-detail .user-name.data-v-79e6a490 {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
  line-height: 1.3;
}
.user-card .user-detail .user-account.data-v-79e6a490 {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 2rpx;
}
.user-card .user-detail .user-position.data-v-79e6a490 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.user-card .login-arrow.data-v-79e6a490 {
  flex-shrink: 0;
  margin-left: 12rpx;
  animation: arrowPulse-79e6a490 1.8s ease-in-out infinite;
}
@keyframes arrowPulse-79e6a490 {
0%, 100% {
    transform: translateX(0);
    opacity: 0.7;
}
50% {
    transform: translateX(8rpx);
    opacity: 1;
}
}
.user-card .user-status.data-v-79e6a490 {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}
.user-card .user-status .status-item.data-v-79e6a490 {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 6rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}
.user-card .user-status .status-item.data-v-79e6a490:active {
  background: rgba(255, 255, 255, 0.1);
}
.user-card .user-status .status-item .status-value.data-v-79e6a490 {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.user-card .user-status .status-item .status-label.data-v-79e6a490 {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.user-card .user-status .status-divider.data-v-79e6a490 {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

/* ============================================================
   功能区块 & 账户设置 – 白色卡片，与设置完全一致
   ============================================================ */
.function-section.data-v-79e6a490,
.account-section.data-v-79e6a490 {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  /* 左右24，底部24（顶部由上一元素间距撑开） */
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  padding: 0 32rpx;
  /* 左右内边距与设置一致 */
}

/* 区块标题 – 仿设置页面的 .list-title */
.section-header .section-title.data-v-79e6a490 {
  display: block;
  font-size: 28rpx;
  color: #999999;
  padding: 32rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.section-header .section-title.data-v-79e6a490::before {
  display: none;
}

/* ============================================================
   我的功能 – 网格布局（图标统一 44rpx，文字 28rpx）
   ============================================================ */
.function-section.data-v-79e6a490 {
  padding: 0 32rpx 16rpx;
  /* 底部留白 */
}
.function-section .function-grid.data-v-79e6a490 {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 12rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490 {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
  min-width: 100rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490:active {
  background: rgba(0, 0, 0, 0.03);
  transform: scale(0.96);
}
.function-section .function-grid .grid-item .item-icon.data-v-79e6a490 {
  width: 80rpx;
  /* 适应44rpx图标 */
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}
.function-section .function-grid .grid-item:active .item-icon.data-v-79e6a490 {
  transform: scale(0.92);
}
.function-section .function-grid .grid-item .item-text.data-v-79e6a490 {
  font-size: 28rpx;
  /* 与设置标签一致 */
  color: #666666;
  font-weight: 500;
  text-align: center;
}

/* ============================================================
   账户设置 – 列表项与设置完全一致
   ============================================================ */
.account-section.data-v-79e6a490 {
  padding: 0 32rpx 4rpx;
  /* 底部留白 */
}
.account-section .account-list .account-item.data-v-79e6a490 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  /* 固定高度，与设置一致 */
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}
.account-section .account-list .account-item.data-v-79e6a490:last-child {
  border-bottom: none;
}
.account-section .account-list .account-item.data-v-79e6a490:active {
