/* ============================================================
   设计变量（与首页完全一致）
   ============================================================ */
.data-v-79e6a490:root {
  --color-primary: #2979ff;
  --color-primary-light: #5a9cff;
  --color-bg: #f5f7fa;
  --color-card: #ffffff;
  --color-text-primary: #1a1a2e;
  --color-text-secondary: #666;
  --color-text-light: #999;
  --color-border: #f0f0f0;
  --shadow-card: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  --shadow-hover: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  --radius-card: 20rpx;
  --card-gap: 24rpx;
  /* 👈 统一间距变量，与首页完全一致 */
}

/* ============================================================
   页面背景 - 与首页完全一致
   ============================================================ */
.page.data-v-79e6a490 {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ============================================================
   用户信息卡片 ———— 间距 24rpx（8网格标准）
   ============================================================ */
.user-card.data-v-79e6a490 {
  background: linear-gradient(145deg, #4a7aff 0%, #6c8cff 60%, #8aa4ff 100%);
  border-radius: var(--radius-card);
  margin: var(--card-gap) 24rpx;
  /* 上下24rpx，与首页完全一致 */
  padding: 40rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(41, 121, 255, 0.25);
  /* 装饰光晕 - 与首页一致 */
}
.user-card.not-login.data-v-79e6a490 {
  background: linear-gradient(145deg, #ff6b6b 0%, #ff8e8e 60%, #ffb0b0 100%);
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 107, 0.25);
}
.user-card.data-v-79e6a490::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  pointer-events: none;
}
.user-card.data-v-79e6a490::after {
  content: "";
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}
.user-card .card-content.data-v-79e6a490 {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.user-card .avatar-section.data-v-79e6a490 {
  flex-shrink: 0;
  margin-right: 24rpx;
}
.user-card .avatar-section.data-v-79e6a490 .u-avatar {
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.user-card .user-detail.data-v-79e6a490 {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.user-card .user-detail .user-name.data-v-79e6a490 {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
  line-height: 1.3;
}
.user-card .user-detail .user-account.data-v-79e6a490 {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 2rpx;
}
.user-card .user-detail .user-position.data-v-79e6a490 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.user-card .login-arrow.data-v-79e6a490 {
  flex-shrink: 0;
  margin-left: 12rpx;
  animation: arrowPulse-79e6a490 1.8s ease-in-out infinite;
}
@keyframes arrowPulse-79e6a490 {
0%, 100% {
    transform: translateX(0);
    opacity: 0.7;
}
50% {
    transform: translateX(8rpx);
    opacity: 1;
}
}
.user-card .user-status.data-v-79e6a490 {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}
.user-card .user-status .status-item.data-v-79e6a490 {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 6rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}
.user-card .user-status .status-item.data-v-79e6a490:active {
  background: rgba(255, 255, 255, 0.1);
}
.user-card .user-status .status-item .status-value.data-v-79e6a490 {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.user-card .user-status .status-item .status-label.data-v-79e6a490 {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.user-card .user-status .status-divider.data-v-79e6a490 {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

/* ============================================================
   区块通用样式 ———— 所有区块 margin: 24rpx 24rpx
   ============================================================ */
.function-section.data-v-79e6a490,
.account-section.data-v-79e6a490 {
  background: var(--color-card);
  margin: var(--card-gap) 24rpx;
  /* 上下24rpx，与首页完全一致 */
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: box-shadow 0.2s;
}
.function-section.data-v-79e6a490:hover,
.account-section.data-v-79e6a490:hover {
  box-shadow: var(--shadow-hover);
}
.section-header.data-v-79e6a490 {
  padding: 18rpx 24rpx 8rpx;
}
.section-header .section-title.data-v-79e6a490 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.5rpx;
}
.section-header .section-title.data-v-79e6a490::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: #2979ff;
  border-radius: 4rpx;
  margin-right: 14rpx;
  vertical-align: middle;
}

/* ============================================================
   我的功能
   ============================================================ */
.function-section.data-v-79e6a490 {
  padding: 6rpx 8rpx 16rpx;
}
.function-section .function-grid.data-v-79e6a490 {
  display: flex;
  justify-content: space-around;
  padding: 0 8rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490 {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
  min-width: 100rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490:active {
  background: rgba(0, 0, 0, 0.03);
  transform: scale(0.96);
}
.function-section .function-grid .grid-item .item-icon.data-v-79e6a490 {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}
.function-section .function-grid .grid-item:active .item-icon.data-v-79e6a490 {
  transform: scale(0.92);
}
.function-section .function-grid .grid-item .item-text.data-v-79e6a490 {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  text-align: center;
}

/* ============================================================
   账户设置
   ============================================================ */
.account-section.data-v-79e6a490 {
  padding: 6rpx 0 4rpx;
}
.account-section .account-list .account-item.data-v-79e6a490 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  transition: all 0.2s;
  min-height: 80rpx;
}
.account-section .account-list .account-item.data-v-79e6a490:active {
  background: rgba(0, 0, 0, 0.02);
}
.account-section .account-list .account-item.data-v-79e6a490:not(:last-child) {
  border-bottom: 1rpx solid #f0f2f5;
}
.account-section .account-list .account-item .item-left.data-v-79e6a490 {
  display: flex;
  align-items: center;
  flex: 1;
}
.account-section .account-list .account-item .item-left .item-icon-wrapper.data-v-79e6a490 {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}
.account-section .account-list .account-item .item-left .item-title.data-v-79e6a490 {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.account-section .account-list .account-item .item-right.data-v-79e6a490 {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.account-section .account-list .account-item .item-right .item-desc.data-v-79e6a490 {
  font-size: 24rpx;
  color: #ff9900;
  margin-right: 10rpx;
}
.account-section .account-list .account-item .feedback-btn.data-v-79e6a490 {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
  position: relative;
}
.account-section .account-list .account-item .feedback-btn.data-v-79e6a490::after {
  display: none;
}

/* ============================================================
   公告详情弹窗
   ============================================================ */
.detail-popup.data-v-79e6a490 {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.detail-popup .detail-scroll.data-v-79e6a490 {
  flex: 1;
  padding: 30rpx 32rpx 40rpx;
}
.detail-popup .detail-title.data-v-79e6a490 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.detail-popup .detail-meta.data-v-79e6a490 {
  font-size: 24rpx;
  color: #b0b7c3;
  margin-bottom: 30rpx;
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}
.detail-popup .detail-content.data-v-79e6a490 {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* ============================================================
   响应式适配 ———— 与首页完全一致
   ============================================================ */
@media (max-width: 750px) {
.user-card.data-v-79e6a490,
.function-section.data-v-79e6a490,
.account-section.data-v-79e6a490 {
    margin-left: 20rpx;
    margin-right: 20rpx;
}
.user-card.data-v-79e6a490 {
    padding: 32rpx 24rpx 24rpx;
}
.user-card .user-detail .user-name.data-v-79e6a490 {
    font-size: 30rpx;
}
.user-card .user-status .status-value.data-v-79e6a490 {
    font-size: 28rpx;
}
.user-card .user-status .status-label.data-v-79e6a490 {
    font-size: 20rpx;
}
.user-card .avatar-section.data-v-79e6a490 .u-avatar {
    width: 80rpx !important;
    height: 80rpx !important;
}
.function-section.data-v-79e6a490 {
    padding: 4rpx 4rpx 12rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490 {
    min-width: 80rpx;
    padding: 8rpx 8rpx;
}
.function-section .function-grid .grid-item .item-icon.data-v-79e6a490 {
    width: 64rpx;
    height: 64rpx;
}
.function-section .function-grid .grid-item .item-text.data-v-79e6a490 {
    font-size: 22rpx;
}
.account-section .account-list .account-item.data-v-79e6a490 {
    padding: 20rpx 20rpx;
    min-height: 72rpx;
}
.account-section .account-list .account-item .item-left .item-title.data-v-79e6a490 {
    font-size: 26rpx;
}
.account-section .account-list .account-item .item-left .item-icon-wrapper.data-v-79e6a490 {
    width: 40rpx;
    height: 40rpx;
}
.section-header.data-v-79e6a490 {
    padding: 14rpx 20rpx 6rpx;
}
.section-header .section-title.data-v-79e6a490 {
    font-size: 28rpx;
}
}
@media (max-width: 400px) {
.user-card.data-v-79e6a490 {
    padding: 24rpx 18rpx 18rpx;
}
.user-card .user-status .status-value.data-v-79e6a490 {
    font-size: 24rpx;
}
.user-card .user-status .status-label.data-v-79e6a490 {
    font-size: 18rpx;
}
.function-section .function-grid .grid-item.data-v-79e6a490 {
    min-width: 60rpx;
}
.function-section .function-grid .grid-item .item-icon.data-v-79e6a490 {
    width: 56rpx;
    height: 56rpx;
}
.function-section .function-grid .grid-item .item-text.data-v-79e6a490 {
    font-size: 20rpx;
}
}