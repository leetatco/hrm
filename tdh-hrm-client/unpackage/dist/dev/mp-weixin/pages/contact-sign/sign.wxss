/* 全局基础 */
page.data-v-8ed2ed6a {
		height: 100%;
		overflow: hidden;
		background: #f5f6f8;
}
.sign-page.data-v-8ed2ed6a {
		height: 100vh;
		background: #f5f6f8;
		display: flex;
		flex-direction: column;
}

	/* ============ 合约卡片样式 ============ */
.detail-container.data-v-8ed2ed6a {
		flex: 1;
		display: flex;
		flex-direction: column;
		overflow: hidden;
}
.detail-scroll.data-v-8ed2ed6a {
		flex: 1;
		height: 0;
		padding: 24rpx;
		box-sizing: border-box;
}
.contract-card.data-v-8ed2ed6a {
		background: #ffffff;
		border-radius: 20rpx;
		padding: 30rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
		margin-bottom: 24rpx;
}
.card-header.data-v-8ed2ed6a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 30rpx;
		padding-bottom: 20rpx;
		border-bottom: 1rpx solid #eee;
}
.card-header .title.data-v-8ed2ed6a {
		font-size: 34rpx;
		font-weight: bold;
		color: #333;
}
.status-tag.data-v-8ed2ed6a {
		font-size: 24rpx;
		padding: 6rpx 16rpx;
		border-radius: 8rpx;
}
.status-tag.unsigned.data-v-8ed2ed6a {
		background: #fff1f0;
		color: #f56c6c;
}
.status-tag.signed.data-v-8ed2ed6a {
		background: #f0f9eb;
		color: #67c23a;
}
.info-row.data-v-8ed2ed6a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18rpx 0;
		font-size: 28rpx;
}
.info-row .label.data-v-8ed2ed6a {
		color: #888;
}
.info-row .value.data-v-8ed2ed6a {
		color: #333;
		font-weight: 500;
}

	/* 文件预览框 */
.file-box.data-v-8ed2ed6a {
		display: flex;
		align-items: center;
		background: #f8f9fb;
		border-radius: 12rpx;
		padding: 20rpx;
		margin-top: 24rpx;
}
.file-icon.data-v-8ed2ed6a {
		font-size: 40rpx;
		margin-right: 16rpx;
}
.file-info.data-v-8ed2ed6a {
		flex: 1;
		display: flex;
		flex-direction: column;
}
.file-title.data-v-8ed2ed6a {
		font-size: 28rpx;
		color: #333;
		font-weight: 500;
}
.file-tip.data-v-8ed2ed6a {
		font-size: 22rpx;
		color: #999;
		margin-top: 4rpx;
}
.preview-btn.data-v-8ed2ed6a {
		background: #008ef6;
		color: #fff;
		border-radius: 30rpx;
		font-size: 24rpx;
		padding: 0 24rpx;
		height: 56rpx;
		line-height: 56rpx;
		margin: 0;
}

	/* 提醒样式 */
.reminder.data-v-8ed2ed6a {
		display: flex;
		padding: 24rpx;
		background: #fff8e1;
		border-radius: 16rpx;
		font-size: 24rpx;
		color: #b88230;
		line-height: 1.6;
}
.reminder-icon.data-v-8ed2ed6a {
		margin-right: 12rpx;
		font-size: 32rpx;
}

	/* 底部按钮 */
.btn-sign-wrapper.data-v-8ed2ed6a {
		padding: 20rpx 32rpx 40rpx;
		background: #f5f6f8;
}
.btn-sign.data-v-8ed2ed6a {
		width: 100%;
		background: linear-gradient(90deg, #008ef6, #00b4ff);
		color: #fff;
		border-radius: 48rpx;
		height: 88rpx;
		line-height: 88rpx;
		font-size: 32rpx;
		font-weight: 500;
		border: none;
		box-shadow: 0 8rpx 16rpx rgba(0, 142, 246, 0.2);
}
.btn-sign.disabled.data-v-8ed2ed6a {
		background: #ccc;
		box-shadow: none;
}
.loading-detail.data-v-8ed2ed6a {
		text-align: center;
		padding: 100rpx 0;
		color: #999;
		font-size: 28rpx;
}

	/* ================= 签名板原有样式（完全恢复） ================= */
.sign-board-full.data-v-8ed2ed6a {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: #fbfbfb;
		z-index: 999;
}
.wrapper.data-v-8ed2ed6a {
		width: 100%;
		height: 95vh;
		margin: 40rpx 0;
		overflow: hidden;
		display: flex;
		align-content: center;
		flex-direction: row;
		justify-content: center;
		font-size: 28rpx;
}
.handWriting.data-v-8ed2ed6a {
		background: #fff;
		width: 100%;
		height: 95vh;
}
.handRight.data-v-8ed2ed6a {
		display: inline-flex;
		align-items: center;
}
.handCenter.data-v-8ed2ed6a {
		border: none;
		/* 去掉边框，如果需要视觉上的框，放在 canvas 外层或使用背景图 */
		flex: 5;
		overflow: hidden;
		box-sizing: border-box;
}
.handTitle.data-v-8ed2ed6a {
		transform: rotate(90deg);
		flex: 1;
		color: #666;
}
.handBtn button.data-v-8ed2ed6a {
		font-size: 28rpx;
}
.handBtn.data-v-8ed2ed6a {
		height: 95vh;
		display: inline-flex;
		flex-direction: column;
		justify-content: space-between;
		align-content: space-between;
		flex: 1;
}
.delBtn.data-v-8ed2ed6a {
		position: absolute;
		top: 250rpx;
		left: 0rpx;
		transform: rotate(90deg);
		color: #666;
}
.delBtn image.data-v-8ed2ed6a {
		position: absolute;
		top: 13rpx;
		left: 25rpx;
}
.subBtn.data-v-8ed2ed6a {
		position: absolute;
		bottom: 52rpx;
		left: -3rpx;
		display: inline-flex;
		transform: rotate(90deg);
		background: #008ef6;
		color: #fff;
		margin-bottom: 30rpx;
		text-align: center;
		justify-content: center;
}
.previewBtn.data-v-8ed2ed6a {
		position: absolute;
		top: 375rpx;
		left: 0rpx;
		transform: rotate(90deg);
		color: #666;
}
.undoBtn.data-v-8ed2ed6a {
		position: absolute;
		top: 500rpx;
		left: 0rpx;
		transform: rotate(90deg);
		color: #666;
}
.closeBtn.data-v-8ed2ed6a {
		position: absolute;
		top: 625rpx;
		left: 0rpx;
		transform: rotate(90deg);
		color: #666;
}
.black-select.data-v-8ed2ed6a {
		width: 60rpx;
		height: 60rpx;
		position: absolute;
		top: 30rpx;
		left: 25rpx;
}
.red-select.data-v-8ed2ed6a {
		width: 60rpx;
		height: 60rpx;
		position: absolute;
		top: 140rpx;
		left: 25rpx;
}
.color_pic.data-v-8ed2ed6a {
		width: 70rpx;
		height: 70rpx;
		border-radius: 25px;
		position: absolute;
		top: 60rpx;
		left: 18rpx;
		border: 1px solid #ddd;
}