{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "存储文档 ID，系统自动生成"
		},
		"single_punch_rule": {
			"title": "只打一次卡处理",
			"bsonType": "int",
			"description": "1=当日有请假/出差则不计异常，否则记旷工；2=一律记旷工；3=一律记早退或迟到；4=不处理",
			"enum": [1, 2, 3, 4],
			"defaultValue": 1
		},
		"late_early_coexist_rule": {
			"title": "迟到与早退同时存在",
			"bsonType": "int",
			"description": "1=分别记录迟到和早退；2=合并记录一次异常（取严重者）；3=只记迟到；4=只记早退",
			"enum": [1, 2, 3, 4],
			"defaultValue": 1
		},
		"out_office_cancel_absence": {
			"title": "外勤/出差抵消缺勤",
			"bsonType": "bool",
			"description": "如果当天有外勤或出差申请，是否不记旷工/缺卡异常",
			"defaultValue": true
		},
		"overtime_cancel_early": {
			"title": "加班抵消早退",
			"bsonType": "bool",
			"description": "当天有加班审批通过时，是否忽略早退异常",
			"defaultValue": false
		},		
		"out_office_cancel_late": {
			"title": "出差/外勤抵消迟到",
			"bsonType": "bool",
			"defaultValue": false
		},
		"out_office_cancel_early": {
			"title": "出差/外勤抵消早退",
			"bsonType": "bool",
			"defaultValue": false
		},		
		"status": {
			"title": "启用状态",
			"bsonType": "bool",
			"description": "true=启用，false=停用",
			"defaultValue": true
		},
		"remark": {
			"title": "备注",
			"bsonType": "string",
			"trim": "both"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	},
	"version": "0.0.1"
}