{
  "bsonType": "object",
  "required": ["shift_name", "shift_type", "segments"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "存储文档 ID，系统自动生成"
    },
    "shift_name": {
      "title": "班次名称",
      "bsonType": "string",
      "description": "如‘标准白班’、‘早班’",
      "trim": "both"
    },
    "shift_type": {
      "title": "班次类型",
      "bsonType": "int",
      "description": "1=固定班次，2=弹性班次（弹性规则可后续扩展）",
      "enum": [1, 2],
      "defaultValue": 1
    },
    "segments": {
      "title": "班次时段",
      "bsonType": "array",
      "description": "一天内多个工作时段，每个时段独立定义上下班时间",
      "minItems": 1,
      "items": {
        "bsonType": "object",
        "required": ["name", "start_time", "end_time"],
        "properties": {
          "name": {
            "title": "时段名称",
            "bsonType": "string",
            "description": "如‘上午’、‘下午’",
            "trim": "both"
          },
          "start_time": {
            "title": "上班时间",
            "bsonType": "string",
            "description": "格式 HH:mm",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end_time": {
            "title": "下班时间",
            "bsonType": "string",
            "description": "格式 HH:mm",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        }
      }
    },
	"department_id": {
		"title": "所属部门",
		"bsonType": "string",
		"foreignKey": "hrm-departments.department_id",
		"description": "所属部门",
		"trim": "both"
	},
	"company_id": {
		"title": "所属公司",
		"bsonType": "string",
		"foreignKey": "hrm-companys.company_id",
		"description": "所属公司",
		"trim": "both"
	},
    "status": {
      "title": "启用状态",
      "bsonType": "bool",
      "description": "true=启用，false=停用",
      "defaultValue": true
    },
    "remark": {
      "title": "备注",
      "bsonType": "string",
      "description": "备注信息",
      "trim": "both"
    },
    "update_date": {
      "title": "更新时间",
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updat_id": {
      "title": "更新人",
      "bsonType": "string",
      "description": "更新人ID",
      "trim": "both",
      "foreignKey": "uni-id-users._id",
      "forceDefaultValue": {
        "$env": "uid"
      }
    }
  },
  "version": "1.0.0"
}