{
  "bsonType": "object",
  "required": ["employee_id", "attendance_date"],
  "properties": {
    "_id": {
      "description": "ID"
    },
    "employee_id": {
      "title": "员工工号",
      "bsonType": "string"
    },
    "attendance_date": {
      "title": "考勤日期",
      "bsonType": "string",
      "description": "yyyy-MM-dd"
    },
    "shift_id": {
      "title": "当天班次ID",
      "bsonType": "string"
    },
    "shift_name": {
      "title": "班次名称",
      "bsonType": "string"
    },
    "schedule_type": {
      "title": "排班类型",
      "bsonType": "int",
      "description": "1=工作日,2=休息日,3=节假日,4=调休工作日"
    },
    "segments": {
      "title": "班次时段打卡详情",
      "bsonType": "array",
      "description": "每个工作时段的具体打卡和异常情况",
      "items": {
        "bsonType": "object",
        "properties": {
          "segment_name": { "bsonType": "string", "description": "时段名称，如上午、下午" },
          "start_time": { "bsonType": "string", "description": "时段上班时间 HH:mm" },
          "end_time": { "bsonType": "string", "description": "时段下班时间 HH:mm" },
          "clock_in": { "bsonType": "string", "description": "实际签到时间 HH:mm" },
          "clock_out": { "bsonType": "string", "description": "实际签退时间 HH:mm" },
          "late_minutes": { "bsonType": "int", "description": "该时段迟到分钟数" },
          "early_minutes": { "bsonType": "int", "description": "该时段早退分钟数" },
          "missing_in": { "bsonType": "bool", "description": "是否缺签到卡" },
          "missing_out": { "bsonType": "bool", "description": "是否缺签退卡" }
        }
      }
    },
    "clock_in": {
      "title": "最早签到时间",
      "bsonType": "string",
      "description": "汇总字段，取所有时段最早的签到时间"
    },
    "clock_out": {
      "title": "最晚签退时间",
      "bsonType": "string",
      "description": "汇总字段，取所有时段最晚的签退时间"
    },
    "late_minutes": {
      "title": "总迟到分钟数",
      "bsonType": "int",
      "defaultValue": 0,
      "description": "所有时段迟到分钟数之和"
    },
    "early_minutes": {
      "title": "总早退分钟数",
      "bsonType": "int",
      "defaultValue": 0,
      "description": "所有时段早退分钟数之和"
    },
    "absent_minutes": {
      "title": "旷工分钟数",
      "bsonType": "int",
      "defaultValue": 0
    },
    "overtime_hours": {
      "title": "加班小时数",
      "bsonType": "double",
      "defaultValue": 0
    },
    "leave_hours": {
      "title": "请假小时数",
      "bsonType": "double",
      "defaultValue": 0
    },
    "trip_hours": {
      "title": "出差小时数",
      "bsonType": "double",
      "defaultValue": 0
    },
    "compensatory_hours": {
      "title": "调休小时数",
      "bsonType": "double",
      "defaultValue": 0
    },
    "remedy_flag": {
      "title": "是否有补卡",
      "bsonType": "bool",
      "defaultValue": false
    },
    "attendance_status": {
      "title": "考勤状态",
      "bsonType": "int",
      "description": "0=异常,1=正常,2=请假,3=出差,4=调休,5=旷工"
    },
    "update_date": {
      "title": "更新时间",
      "bsonType": "timestamp",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updat_id": {
      "title": "更新人",
      "bsonType": "string"
    }
  }
}