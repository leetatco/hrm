{
	"bsonType": "object",
	"required": ["address", "longitude", "latitude", "distance_in"],
	"permission": {
		"create": true,
		"delete": true,
		"read": true,
		"update": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"address": {
			"bsonType": "string",
			"description": "位置",
			"trim": "both"
		},		
		"bssid": {
			"title": "wifi名称",
			"bsonType": "string",
			"description": "wifi名称",
			"trim": "both"
		},
		"ssid": {
			"title": "wifiMac地址",
			"bsonType": "string",
			"description": "wifiMac地址",
			"trim": "both"
		},
		"signalStrength": {
			"title": "wifi信号强度",
			"bsonType": "int",
			"description": "Wi-Fi 信号强度, 安卓取值 0 ～ 100",
			"trim": "both"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	}
}