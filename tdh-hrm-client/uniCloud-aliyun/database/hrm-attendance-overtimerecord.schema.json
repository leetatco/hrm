			"description": "ID"
		},
		"employee_id": {
			"title": "员工工号",
			"bsonType": "string"
		},
		"oa_instance_id": {
			"title": "OA申请ID",
			"bsonType": "string"
		},
		"overtime_date": {
			"title": "加班日期",
			"bsonType": "string"
		},
		"total_minutes": {
			"title": "加班时数",
			"bsonType": "double"
		},
		"overtime_type": {
			"title": "加班类型",
