{
  "bsonType": "object",
  "required": ["calendar_date", "date_type"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "存储文档 ID，系统自动生成"
    },
    "calendar_date": {
      "title": "日期",
      "bsonType": "string",
      "description": "具体日期，格式 YYYY-MM-DD，如 2026-07-01。唯一标识，不允许重复。",
      "trim": "none",
      "unique": true
    },
    "date_type": {
      "title": "日期类型",
      "bsonType": "int",
      "description": "1=工作日，2=周末/常规休息日，3=法定节假日，4=调休工作日",
      "enum": [1, 2, 3, 4]
    },
    "year": {
      "title": "所属年份",
      "bsonType": "int",
      "description": "年份，如 2026，便于按年度查询和维护"
    },
    "name": {
      "title": "节日说明",
      "bsonType": "string",
      "description": "节假日名称或调休说明，如“国庆节”、“春节调休上班日”",
      "trim": "both"
    },
    "is_default": {
      "title": "是否默认生成",
      "bsonType": "bool",
      "description": "0=人工单独指定，1=按周末默认批量生成",
      "defaultValue": false
    },
    "remark": {
      "title": "备注",
      "bsonType": "string",
      "description": "备注信息",
      "trim": "both"
    },
    "update_date": {
      "title": "更新时间",
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updat_id": {
      "title": "更新人",
      "bsonType": "string",
      "description": "更新人ID",
      "trim": "both",
      "foreignKey": "uni-id-users._id",
      "forceDefaultValue": {
        "$env": "uid"
      }
    }
  },
  "version": "0.0.1"
}