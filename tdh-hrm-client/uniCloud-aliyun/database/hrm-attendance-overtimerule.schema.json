{
  "bsonType": "object",
  "required": ["rule_name"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "存储文档 ID，系统自动生成"
    },
    "rule_name": {
      "title": "规则名称",
      "bsonType": "string",
      "description": "如‘标准加班规则’",
      "trim": "both"
    },
    "weekday_overtime_ratio": {
      "title": "工作日加班系数",
      "bsonType": "double",
      "description": "工作日加班计算倍数，如1.5",
      "defaultValue": 1.5
    },
    "weekend_overtime_ratio": {
      "title": "休息日加班系数",
      "bsonType": "double",
      "description": "休息日加班计算倍数，如2.0",
      "defaultValue": 2.0
    },
    "holiday_overtime_ratio": {
      "title": "节假日加班系数",
      "bsonType": "double",
      "description": "法定节假日加班计算倍数，如3.0",
      "defaultValue": 3.0
    },
    "min_calculate_unit": {
      "title": "最小计算单位(分钟)",
      "bsonType": "int",
      "description": "加班不足此分钟数不计入，如30分钟",
      "defaultValue": 30
    },
    "compensate_type": {
      "title": "补偿方式",
      "bsonType": "int",
      "description": "1=调休优先，2=计薪优先，3=仅计薪，4=仅调休",
      "enum": [1, 2, 3, 4],
      "defaultValue": 1
    },
    "max_daily_overtime": {
      "title": "每日最大加班(小时)",
      "bsonType": "int",
      "description": "0表示无限制",
      "defaultValue": 0
    },
    "max_monthly_overtime": {
      "title": "每月最大加班(小时)",
      "bsonType": "int",
      "description": "0表示无限制",
      "defaultValue": 0
    },
    "status": {
      "title": "启用状态",
      "bsonType": "bool",
      "description": "true=启用，false=停用",
      "defaultValue": true
    },
    "remark": {
      "title": "备注",
      "bsonType": "string",
      "description": "备注信息",
      "trim": "both"
    },
    "update_date": {
      "title": "更新时间",
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updat_id": {
      "title": "更新人",
      "bsonType": "string",
      "description": "更新人ID",
      "trim": "both",
      "foreignKey": "uni-id-users._id",
      "forceDefaultValue": {
        "$env": "uid"
      }
    }
  },
  "version": "0.0.1"
}