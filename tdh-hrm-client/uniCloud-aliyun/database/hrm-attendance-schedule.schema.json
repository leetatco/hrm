{
  "bsonType": "object",
  "required": ["employee_id", "schedule_date", "shift_id"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "存储文档 ID，系统自动生成"
    },
    "employee_id": {
      "title": "员工工号",
      "bsonType": "string",
      "description": "关联员工表 employee_id",
      "trim": "both"
    },
    "schedule_date": {
      "title": "排班日期",
      "bsonType": "string",
      "description": "格式 YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "shift_id": {
      "title": "班次",
      "bsonType": "string",
      "description": "关联班次表 _id，为空表示休息",
      "trim": "both"
    },
    "attendance_group_id": {
      "title": "所属考勤组",
      "bsonType": "string",
      "description": "关联考勤组表 _id，用于快速筛选和批量生成",
      "trim": "both"
    },
    "status": {
      "title": "启用状态",
      "bsonType": "bool",
      "description": "true=启用，false=停用",
      "defaultValue": true
    },
    "remark": {
      "title": "备注",
      "bsonType": "string",
      "description": "备注信息",
      "trim": "both"
    },
    "update_date": {
      "title": "更新时间",
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updat_id": {
      "title": "更新人",
      "bsonType": "string",
      "description": "更新人ID",
      "trim": "both",
      "foreignKey": "uni-id-users._id",
      "forceDefaultValue": {
        "$env": "uid"
      }
    }
  },
  "version": "0.0.1"
}