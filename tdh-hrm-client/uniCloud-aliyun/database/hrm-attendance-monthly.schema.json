{
	"bsonType": "object",
	"required": ["employee_id", "attendance_ym"],
	"properties": {
		"_id": {
			"description": "ID"
		},
		"employee_id": {
			"title": "员工工号",
			"bsonType": "string"
		},
		"card": {
			"title": "身份证号码",
			"bsonType": "string",
			"description": "员工身份证号码，冗余字段，便于薪资核算",
			"trim": "both"
		},
		"attendance_ym": {
			"title": "考勤月份",
			"bsonType": "date",
			"description": "考勤月份，格式 yyyy-MM，如 2026-08",
			"trim": "both"
		},
		"period_start": {
			"title": "统计周期开始日期",
			"bsonType": "string",
			"description": "yyyy-MM-dd"
		},
		"period_end": {
			"title": "统计周期结束日期",
			"bsonType": "string"
		},
		"should_days": {
			"title": "应出勤天数",
			"bsonType": "double",
			"defaultValue": 0
		},
		"actual_days": {
			"title": "实际出勤天数",
			"bsonType": "double",
			"defaultValue": 0
		},
		"should_minutes": {
			"title": "应出勤总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"actual_minutes": {
			"title": "实际出勤总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"pay_days": {
			"title": "计薪天数",
			"bsonType": "double",
			"description": "日薪/时薪员工的计薪天数",
			"defaultValue": 0
		},
		"pay_hours": {
			"title": "计薪小时数",
			"bsonType": "double",
			"description": "时薪员工的计薪小时数",
			"defaultValue": 0
		},
		"salary_type": {
			"title": "计薪方式",
			"bsonType": "int",
			"description": "1=月薪，2=日薪，3=时薪",
			"enum": [1, 2, 3],
			"defaultValue": 1
		},
		"salary": {
			"title": "综合工资",
			"bsonType": "int",
			"description": "从定薪表冗余过来，便于薪资核算"
		},
		"rest_days": {
			"title": "休息天数",
			"bsonType": "double",
			"defaultValue": 0
		},
		"late_count": {
			"title": "迟到次数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"late_minutes": {
			"title": "迟到总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"early_count": {
			"title": "早退次数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"early_minutes": {
			"title": "早退总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"no_punch_count": {
			"title": "未打卡次数",
			"bsonType": "int",
			"description": "当天缺签到或缺签退的次数合计",
			"defaultValue": 0
		},
		"absent_count": {
			"title": "旷工次数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"absent_minutes": {
			"title": "旷工总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"overtime_minutes": {
			"title": "加班总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"overtime_compensatory_minutes": {
			"title": "调休加班分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"overtime_paid_minutes": {
			"title": "计薪加班分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"leave_minutes": {
			"title": "请假总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"trip_minutes": {
			"title": "出差总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"outing_minutes": {
			"title": "外出总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"compensatory_minutes": {
			"title": "调休总分钟数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"exempted": {
			"title": "是否豁免",
			"bsonType": "bool",
			"defaultValue": false
		},
		"exemption_reason": {
			"title": "豁免原因",
			"bsonType": "string"
		},
		"remedy_count": {
			"title": "补卡次数",
			"bsonType": "int",
			"defaultValue": 0
		},
		"full_attendance": {
			"title": "是否全勤",
			"bsonType": "bool",
			"defaultValue": false
		},
		"contract_days": {
			"title": "合同天数",
			"bsonType": "double",
			"description": "从定薪表冗余，主要用于月薪人员",
			"defaultValue": 0
		},
		"diff_days": {
			"title": "差异天数",
			"bsonType": "double",
			"description": "合同天数 - 应出勤天数；大于 0 表示缺公司天数",
			"defaultValue": 0
		},
		"sign_status": {
			"title": "签单状态",
			"bsonType": "int",
			"description": "0=待签单，1=已签单，2=无需签单",
			"defaultValue": 2
		},
		"signature_url": {
			"title": "签名图片",
			"bsonType": "string",
			"description": "手写签名图片存储路径（云存储 fileID），由小程序端签单写入",
			"trim": "both"
		},
		"sign_date": {
			"title": "签单日期",
			"bsonType": "timestamp",
			"description": "小程序端签单时间"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"update_id": {
			"title": "更新人",
			"bsonType": "string"
		}
	},
	"indexes": [{
		"name": "uk_employee_month",
		"type": "unique",
		"key": {
			"employee_id": 1,
			"attendance_ym": 1
		}
	}]
}