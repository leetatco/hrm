{
	"bsonType": "object",
	"required": ["contract_sign_id", "contract_sign_name"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "存储文档 ID，系统自动生成"
		},
		"contract_sign_id": {
			"title": "合同代码",
			"bsonType": "string",
			"description": "代码唯一标识，不可修改，不允许重复",
			"trim": "both"
		},
		"contract_sign_name": {
			"title": "合同名称",
			"bsonType": "string",
			"description": "合同名称",
			"trim": "both"
		},
		"sign_position": {
			"title": "签名位置配置",
			"bsonType": "object",
			"description": "签名在PDF中的坐标",
			"properties": {
				"page": {
					"bsonType": "int",
					"title": "页码（从1开始，0表示最后一页）",
					"default": 0
				},
				"x": {
					"bsonType": "number",
					"title": "X坐标（pt）",
					"default": 300
				},
				"y": {
					"bsonType": "number",
					"title": "Y坐标（pt，从底部算起）",
					"default": 150
				},
				"width": {
					"bsonType": "number",
					"title": "签名宽度（pt）",
					"default": 150
				},
				"height": {
					"bsonType": "number",
					"title": "签名高度（pt）",
					"default": 60
				}
			}
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	},
	"version": "0.0.1"
}