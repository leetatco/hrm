{
	"bsonType": "object",
	"required": ["contract_sign_id", "contract_sign_name"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "存储文档 ID，系统自动生成"
		},
		"contract_sign_id": {
			"title": "合同代码",
			"bsonType": "string",
			"description": "代码唯一标识，不可修改，不允许重复",
			"trim": "both"
		},
		"contract_sign_name": {
			"title": "合同名称",
			"bsonType": "string",
			"description": "合同名称",
			"trim": "both"
		},
		"company_id": {
			"title": "所属公司",
			"bsonType": "string",
			"foreignKey": "hrm-companys.company_id",
			"description": "所属公司",
			"trim": "both"
		},
		"template_file": {
			"title": "模版文件",
			"bsonType": "string",
			"description": "模版文件",
			"trim": "both"
		},
		"sign_positions": {
			"title": "签名位置配置列表",
			"bsonType": "array",
			"description": "签名在PDF中的多个坐标位置",
			"items": {
				"bsonType": "object",
				"properties": {
					"page": { "bsonType": "int", "title": "页码" },
					"x": { "bsonType": "number", "title": "X坐标" },
					"y": { "bsonType": "number", "title": "Y坐标" },
					"width": { "bsonType": "number", "title": "宽度" },
					"height": { "bsonType": "number", "title": "高度" }
				}
			}
		},
		"text_positions": {
			"title": "文本填充位置配置列表",
			"bsonType": "array",
			"description": "用于填写员工姓名、地址等文本的位置",
			"items": {
				"bsonType": "object",
				"properties": {
					"page": { "bsonType": "int", "title": "页码" },
					"x": { "bsonType": "number", "title": "X坐标" },
					"y": { "bsonType": "number", "title": "Y坐标" },
					"width": { "bsonType": "number", "title": "宽度" },
					"height": { "bsonType": "number", "title": "高度" },
					"fieldKey": { "bsonType": "string", "title": "绑定的员工字段名，如 employee_name" }
				}
			}
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"forceDefaultValue": { "$env": "now" }
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": { "$env": "uid" }
		}
	}
}