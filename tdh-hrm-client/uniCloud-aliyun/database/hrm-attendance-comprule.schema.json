{
	"bsonType": "object",
	"required": ["rule_name"],
	"properties": {
		"_id": {
			"description": "ID"
		},
		"rule_name": {
			"title": "规则名称",
			"bsonType": "string"
		},
		"valid_period": {
			"title": "调休有效期(月)",
			"bsonType": "int",
			"defaultValue": 3
		},
		"auto_expire": {
			"title": "到期自动清零",
			"bsonType": "bool",
			"defaultValue": true
		},
		"same_month_only": {
			"title": "仅限当月调休",
			"bsonType": "bool",
			"description": "true=本月加班产生的调休只能本月使用，不能跨月",
			"defaultValue": false
		},
		"min_unit": {
			"title": "最小调休单位",
			"bsonType": "int",
			"description": "1=小时，2=半天，3=天",
			"enum": [1, 2, 3],
			"defaultValue": 1
		},
		"min_unit_minutes": {
			"title": "最小调休单位(分钟)",
			"bsonType": "int",
			"description": "根据min_unit自动推导，用于统一计算",
			"defaultValue": 60
		},
		"max_accumulate_minutes": {
			"title": "最大累积(分钟)",
			"bsonType": "int",
			"description": "每人可累积的调休时长上限（分钟），0表示无上限",
			"defaultValue": 0
		},
		"overtime_to_comp_ratio": {
			"title": "加班转调休系数",
			"bsonType": "double",
			"description": "如1.5倍：加班1小时得1.5小时调休",
			"defaultValue": 1.0
		},
		"status": {
			"title": "启用状态",
			"bsonType": "bool",
			"description": "true=启用，false=停用",
			"defaultValue": true
		},
		"remark": {
			"title": "备注",
			"bsonType": "string",
			"description": "备注信息",
			"trim": "both"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	},
	"version": "0.0.1"
}