{
	"bsonType": "object",
	"required": ["rule_name"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "存储文档 ID，系统自动生成"
		},
		"rule_name": {
			"title": "规则名称",
			"bsonType": "string",
			"description": "如‘标准调休规则’",
			"trim": "both"
		},
		"valid_period": {
			"title": "调休有效期(月)",
			"bsonType": "int",
			"description": "调休额度在生成后多少个月内可使用，0表示永久有效",
			"defaultValue": 3
		},
		"auto_expire": {
			"title": "到期自动清零",
			"bsonType": "bool",
			"description": "有效期过后未用完的调休是否自动清零",
			"defaultValue": true
		},
		"min_unit": {
			"title": "最小调休单位",
			"bsonType": "int",
			"description": "1=小时，2=半天，3=天",
			"enum": [1, 2, 3],
			"defaultValue": 1
		},
		"max_accumulate": {
			"title": "最大累积(小时)",
			"bsonType": "int",
			"description": "每人可累积的调休时长上限，0表示无上限",
			"defaultValue": 0
		},
		"overtime_to_comp_ratio": {
			"title": "加班转调休系数",
			"bsonType": "double",
			"description": "如1.5倍：加班1小时得1.5小时调休",
			"defaultValue": 1.0
		},
		"status": {
			"title": "启用状态",
			"bsonType": "bool",
			"description": "true=启用，false=停用",
			"defaultValue": true
		},
		"remark": {
			"title": "备注",
			"bsonType": "string",
			"description": "备注信息",
			"trim": "both"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	},
	"version": "0.0.1"
}