{
	"bsonType": "object",
	"required": ["employee_id", "oa_instance_id", "trip_location", "start_time", "end_time"],
	"properties": {
		"_id": {
			"description": "ID"
		},
		"employee_id": {
			"bsonType": "string",
			"description": "员工工号"
		},
		"oa_instance_id": {
			"bsonType": "string",
			"description": "OA申请ID"
		},
		"trip_location": {
			"bsonType": "string",
			"description": "出差地点"
		},
		"start_time": {
			"bsonType": "timestamp",
			"description": "开始时间"
		},
		"end_time": {
			"bsonType": "timestamp",
			"description": "结束时间"
		},
		"total_hours": {
			"bsonType": "double",
			"description": "出差总小时数"
		},
		"trip_type": {
			"bsonType": "string",
			"description": "国内/国际"
		},
		"reason": {
			"bsonType": "string",
			"description": "备注"
		},
		"import_status": {
			"bsonType": "int",
			"defaultValue": 1
		},
		"update_date": {
			"bsonType": "timestamp",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"bsonType": "string"
		}
	}
}