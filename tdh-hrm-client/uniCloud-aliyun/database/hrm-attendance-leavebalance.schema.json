{
	"bsonType": "object",
	"required": ["employee_id", "leave_type_id", "year"],
	"properties": {
		"_id": {
			"description": "ID"
		},
		"employee_id": {
			"title": "员工工号",
			"bsonType": "string"
		},
		"leave_type_id": {
			"title": "假期类型",
			"bsonType": "string"
		},
		"year": {
			"title": "年度",
			"bsonType": "int"
		},
		"total_minutes": {
			"title": "总额度(分钟)",
			"bsonType": "int",
			"defaultValue": 0
		},
		"used_minutes": {
			"title": "已用额度(分钟)",
			"bsonType": "int",
			"defaultValue": 0
		},
		"adjust_reason": {
			"title": "调整原因",
			"bsonType": "string"
		},
		"status": {
			"title": "启用状态",
			"bsonType": "bool",
			"defaultValue": true
		},
		"remark": {
			"title": "备注",
			"bsonType": "string"
		},
		"update_date": {
			"title": "更新时间",
			"bsonType": "timestamp",
			"description": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"title": "更新人",
			"bsonType": "string",
			"description": "更新人ID",
			"trim": "both",
			"foreignKey": "uni-id-users._id",
			"forceDefaultValue": {
				"$env": "uid"
			}
		}
	}
}