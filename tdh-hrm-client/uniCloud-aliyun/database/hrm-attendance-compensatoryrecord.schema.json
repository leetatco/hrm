{
	"bsonType": "object",
	"required": ["employee_id", "compensatory_date", "oa_instance_id", "total_hours"],
	"properties": {
		"_id": {
			"description": "ID"
		},
		"employee_id": {
			"bsonType": "string",
			"description": "员工工号"
		},
		"oa_instance_id": {
			"bsonType": "string",
			"description": "OA申请ID"
		},
		"compensatory_date": {
			"bsonType": "string",
			"description": "调休日期 YYYY-MM-DD"
		},
		"total_hours": {
			"bsonType": "double",
			"description": "本次调休总小时数"
		},
		"items": {
			"bsonType": "array",
			"description": "关联的加班单明细",
			"items": {
				"bsonType": "object",
				"properties": {
					"overtime_id": {
						"bsonType": "string",
						"description": "加班申请ID"
					},
					"overtime_title": {
						"bsonType": "string"
					},
					"deduct_hours": {
						"bsonType": "double",
						"description": "本次调休小时数"
					}
				}
			}
		},
		"reason": {
			"bsonType": "string",
			"description": "备注"
		},
		"import_status": {
			"bsonType": "int",
			"defaultValue": 1
		},
		"update_date": {
			"bsonType": "timestamp",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"updat_id": {
			"bsonType": "string"
		}
	}
}