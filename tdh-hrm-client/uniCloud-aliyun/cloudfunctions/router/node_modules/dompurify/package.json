  "scripts": {
    "bench": "node scripts/benchmark.js",
    "build": "npm run build:types && npm run build:rolldown && npm run build:fix-types && npm run build:cleanup",
    "build:cjs": "cross-env DOMPURIFY_BUILD_TARGET=cjs rolldown -c config/rolldown.config.js",
    "build:cleanup": "rimraf dist/types",
    "build:cov": "rolldown -c config/rolldown.coverage.config.js",
    "build:es": "cross-env DOMPURIFY_BUILD_TARGET=es rolldown -c config/rolldown.config.js",
    "build:fix-types": "node ./scripts/fix-types.js",
    "build:rolldown": "rolldown -c config/rolldown.config.js",
    "build:types": "tsc -p config/tsconfig.json --outDir dist/types --declaration --emitDeclarationOnly",
    "build:umd": "cross-env DOMPURIFY_BUILD_TARGET=umd rolldown -c config/rolldown.config.js",
    "build:umd:min": "cross-env DOMPURIFY_BUILD_TARGET=umd-min rolldown -c config/rolldown.config.js",
    "commit-amend-build": "scripts/commit-amend-build.sh",
    "coverage": "rimraf .nyc_output coverage dist/purify.cov.cjs.js && npm run build:cov && cross-env NODE_ENV=test DOMPURIFY_COV=1 node test/jsdom-node-runner --dot && nyc report --reporter=html --reporter=text --report-dir=coverage",
    "dev": "cross-env NODE_ENV=development DOMPURIFY_BUILD_TARGET=umd rolldown -w -c config/rolldown.config.js",
    "format": "npm run format:js && npm run format:md",
    "format:js": "prettier --write '{src,demos,scripts,test,website}/*.{js,ts}'",
    "format:md": "prettier --write --parser markdown '**/*.md'",
    "lint": "xo src/*.ts",
    "prebuild": "rimraf dist",
    "prepare": "husky",
    "test": "cross-env NODE_ENV=test npm run lint && npm run build && npm run test:jsdom && npm run test:browser -- --project=chromium",
    "test:browser": "playwright test --config config/playwright.config.js",
    "test:browser:install": "playwright install",
    "test:browser:legacy": "node test/browser/legacy-runner.js",
    "test:ci": "cross-env NODE_ENV=test npm run test:jsdom && npm run test:browser",
    "test:fuzz": "cross-env NODE_ENV=test node test/fuzz/sanitize.fast-check.js",
    "test:happydom": "cross-env NODE_ENV=test node test/happydom-node-runner --dot",
    "test:jsdom": "cross-env NODE_ENV=test node test/jsdom-node-runner --dot",
    "test:purify-edge": "cross-env NODE_ENV=test node test/purify-edge-node-runner --dot && cross-env NODE_ENV=test node test/purify-edge-node-runner --dot --sinks",
    "verify-typescript": "node ./typescript/verify.js"
  },
  "types": "./dist/purify.cjs.d.ts",
  "version": "3.4.17",
